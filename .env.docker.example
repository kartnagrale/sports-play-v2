# Copy outside the repository, fill secrets, and protect file access.
# Never commit the filled file or print docker compose config (it expands secrets).
COMPOSE_PROJECT_NAME=playneml-staging
POSTGRES_DB=sports_play
POSTGRES_USER=sports_play_owner
POSTGRES_PASSWORD=
DB_USER=sports_play_app
DB_PASSWORD=
JWT_SECRET=
HTTP_PORT=8080
# Future target only; operator must configure actual TLS and DNS separately.
PUBLIC_ORIGIN=https://play.neml.in
PUBLIC_SCHEME=https
AUTH_COOKIE_SECURE=true
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
CERTIFICATES_PUBLIC_ENABLED=false
CERTIFICATES_PUBLIC_BASE_URL=
