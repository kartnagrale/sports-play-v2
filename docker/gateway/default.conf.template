map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
resolver 127.0.0.11 valid=10s ipv6=off;
upstream backend_api {
    zone backend_api 64k;
    server backend:8001 resolve;
}
upstream frontend_app {
    zone frontend_app 64k;
    server frontend:3000 resolve;
}
server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 6m;
    # Omit query strings, cookies, authorization and verification tokens.
    access_log off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Forwarded-Ssl "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_http_version 1.1;
    location /api/ {
        proxy_pass http://backend_api;
        proxy_buffering off;
    }
    location /ws {
        proxy_pass http://backend_api;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }
    location / {
        proxy_pass http://frontend_app;
    }
}
