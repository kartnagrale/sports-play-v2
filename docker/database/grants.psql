\set ON_ERROR_STOP on
BEGIN;
GRANT USAGE ON SCHEMA play_neml TO :"app_user";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA play_neml TO :"app_user";
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA play_neml TO :"app_user";
-- The application must never alter the migration ledger.
REVOKE ALL ON play_neml.schema_migrations FROM :"app_user";
COMMIT;
